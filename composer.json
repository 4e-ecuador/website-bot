{
    "name": "4e-ecuador/website-bot",
    "description": "A web site and a bot.",
    "type": "project",
    "license": "WTFPL",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "boshurik/telegram-bot-bundle": "^6.0",
        "doctrine/doctrine-bundle": "^3",
        "doctrine/doctrine-fixtures-bundle": "^4",
        "doctrine/doctrine-migrations-bundle": "^4",
        "doctrine/orm": "^3",
        "google/apiclient": "^2.13",
        "knplabs/knp-time-bundle": "^2.0",
        "league/csv": "^9.8",
        "league/oauth2-google": "^5.0",
        "michelf/php-markdown": "^2.0",
        "nelmio/cors-bundle": "^2.0",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "8.*",
        "symfony/asset-mapper": "8.*",
        "symfony/console": "8.*",
        "symfony/dotenv": "8.*",
        "symfony/expression-language": "8.*",
        "symfony/flex": "^2.1",
        "symfony/form": "8.*",
        "symfony/framework-bundle": "8.*",
        "symfony/google-mailer": "8.*",
        "symfony/http-client": "8.*",
        "symfony/intl": "8.*",
        "symfony/mailer": "8.*",
        "symfony/monolog-bundle": "^4",
        "symfony/process": "8.*",
        "symfony/property-access": "8.*",
        "symfony/property-info": "8.*",
        "symfony/runtime": "8.*",
        "symfony/security-bundle": "8.*",
        "symfony/serializer": "8.*",
        "symfony/stimulus-bundle": "^3.4",
        "symfony/translation": "8.*",
        "symfony/twig-bundle": "8.*",
        "symfony/ux-leaflet-map": "^3.6",
        "symfony/ux-map": "^3.6",
        "symfony/validator": "8.*",
        "symfony/web-link": "8.*",
        "symfony/yaml": "8.*",
        "tattali/calendar-bundle": "^8",
        "twig/cssinliner-extra": "^3.0",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/inky-extra": "^3.0",
        "twig/string-extra": "^3.0",
        "twig/twig": "^2.12|^3.0"
    },
    "require-dev": {
        "dbrekelmans/bdi": "^1.4",
        "elkuku/symfony-utils": "dev-master",
        "friendsofphp/php-cs-fixer": "^3.95",
        "jawira/doctrine-diagram-bundle": "dev-main",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-doctrine": "^2",
        "phpstan/phpstan-symfony": "^2",
        "phpunit/phpunit": "^13",
        "rector/rector": "^2",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "8.*",
        "symfony/css-selector": "8.*",
        "symfony/debug-bundle": "8.*",
        "symfony/maker-bundle": "^1.0",
        "symfony/panther": "^2.4",
        "symfony/phpunit-bridge": "8.*",
        "symfony/stopwatch": "8.*",
        "symfony/web-profiler-bundle": "8.*",
        "tomasvotruba/cognitive-complexity": "^1"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "translate": [
            "@translate-all"
        ],
        "translate-all": {
            "en": "./bin/console translation:extract --format=yaml --force en --domain=messages",
            "es": "./bin/console translation:extract --format=yaml --force es --domain=messages",
            "de": "./bin/console translation:extract --format=yaml --force de --domain=messages"
        },
        "test-phpunit": [
            "make tests"
        ],
        "test-phpstan": [
            "vendor/bin/phpstan analyse"
        ],
        "test-phpstan-baseline": [
            "vendor/bin/phpstan analyse --generate-baseline"
        ],
        "ci": [
            "@test-phpunit",
            "@test-phpstan"
        ],
        "check": [
            "echo 'Check for outdated assets:'",
            "bin/console importmap:outdated",
            "echo 'Check for outdated PHP deps:'",
            "composer outdated",
            "echo 'Check for outdated Recipes:'",
            "composer recipes:update"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.*",
            "docker": true
        }
    }
}
