{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - {{ 'Please sign in'|trans }}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://accounts.google.com/gsi/client" async defer></script>
{% endblock %}

{% block body %}
    <div class="row justify-content-center py-5">
        <div class="col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card login-card shadow-sm">
                <div class="card-body p-4 p-sm-5 text-center">
                    <img src="{{ asset('images/logos/4E-global-logo.svg') }}" alt="" width="88" height="88" class="login-logo mb-4">
                    <h1 class="h3 fw-bold mb-2">{{ 'Please sign in'|trans }}</h1>
                    <p class="text-body-secondary mb-4">{{ 'Sign in with your Google account'|trans }}</p>

                    {% if error %}
                        <div class="alert alert-danger text-start">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <div id="g_id_onload"
                         data-client_id="{{ oauthGoogleId }}"
                         data-login_uri="{{ url('connect_google_verify') }}"
                         data-auto_prompt="false">
                    </div>
                    <div class="d-flex justify-content-center login-google">
                        <div class="g_id_signin"
                             data-controller="google-button"
                             data-type="standard"
                             data-size="large"
                             data-theme="outline"
                             data-text="sign_in_with"
                             data-shape="pill"
                             data-logo_alignment="left"
                             data-width="280"
                             data-locale="{{ locale }}">
                        </div>
                    </div>
                </div>
            </div>

            {% if 'dev' == app.environment %}
                <div class="card login-dev mt-4">
                    <div class="card-body">
                        <h2 class="h6 text-body-secondary">Devs only..</h2>
                        <form method="post">
                            <div class="input-group">
                                <input type="email" class="form-control" id="inputEmail" name="email" placeholder="e-mail"
                                       aria-label="e-mail" value="{{ last_username }}" required>
                                <button type="submit" class="btn btn-outline-success">Sign in</button>
                            </div>
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('login') }}">
                        </form>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
